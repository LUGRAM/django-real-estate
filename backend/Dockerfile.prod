# Stage 1 : builder 
FROM python:3.14-slim AS builder

WORKDIR /wheels

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Filtre les packages dev-only (linters, formatters, testing, watchdog)
RUN grep -v -E \
    "^(black|flake8|isort|mypy-extensions|pycodestyle|pyflakes|mccabe|tomli|pathspec|platformdirs|pytest|Faker|watchdog|flower|argh|pyYAML)" \
    requirements.txt > requirements.prod.txt

RUN pip install --upgrade pip && \
    pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.prod.txt gunicorn


# Stage 2 : image finale 
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=real_estate.settings.production

WORKDIR /app

# Libs runtime uniquement (pas les headers de compilation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libjpeg62-turbo \
    zlib1g \
    libssl3 \
    libffi8 \
    && rm -rf /var/lib/apt/lists/*

# Installe depuis les wheels pré-compilés (pas de gcc en prod)
COPY --from=builder /wheels /wheels
COPY --from=builder /wheels/requirements.prod.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.prod.txt gunicorn \
    && rm -rf /wheels /root/.cache

# Utilisateur non-root
RUN addgroup --system django && adduser --system --ingroup django django

# Copies explicites — évite d'inclure .env, logs, tests, secrets
COPY --chown=django:django apps/        ./apps/
COPY --chown=django:django real_estate/ ./real_estate/
COPY --chown=django:django manage.py    .

# Création des logs et collecte des statiques en une seule étape
RUN mkdir -p /app/logs && touch /app/logs/real_estate.log && \
    SECRET_KEY=build-dummy \
    DEBUG=False \
    ALLOWED_HOSTS=localhost \
    SIGNING_KEY=build-dummy-signing-key \
    EMAIL_HOST=localhost \
    EMAIL_HOST_USER=dummy \
    EMAIL_HOST_PASSWORD=dummy \
    EMAIL_PORT=25 \
    DOMAIN=localhost \
    CELERY_BROKER=redis://localhost:6379/0 \
    CELERY_BACKEND=redis://localhost:6379/0 \
    POSTGRES_ENGINE=django.db.backends.postgresql \
    POSTGRES_USER=dummy \
    POSTGRES_PASSWORD=dummy \
    POSTGRES_DB=dummy \
    PG_HOST=localhost \
    PG_PORT=5432 \
    python manage.py collectstatic --noinput \
    && chown -R django:django /app
      
USER django

EXPOSE 8000

CMD ["gunicorn", "real_estate.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]
